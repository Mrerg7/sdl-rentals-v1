---
import { ACQUISITION_MAILTO, DISCLAIMER_DATE, SITE } from "../config/site";
---

<footer class="border-t border-slate-100 bg-white">
  <div class="mx-auto max-w-5xl px-6 py-16">
    <div class="relative mb-12 overflow-hidden rounded-3xl border border-amber-700/25 bg-gradient-to-br from-slate-900 via-slate-950 to-amber-900/20 p-8 sm:p-12">
      <div
        class="pointer-events-none absolute -right-24 -top-24 h-64 w-64 rounded-full bg-amber-700/10 blur-3xl"
        aria-hidden="true"
      ></div>
      <div
        class="pointer-events-none absolute -bottom-24 -left-24 h-64 w-64 rounded-full bg-amber-600/10 blur-3xl"
        aria-hidden="true"
      ></div>

      <div class="relative z-10 grid items-center gap-10 lg:grid-cols-[1.2fr_0.8fr]">
        <div>
          <p class="mb-4 text-xs font-extrabold uppercase tracking-[3px] text-amber-500">
            Domain Available for Acquisition
          </p>
          <h2 class="heading-serif mb-4 text-3xl tracking-tight text-white sm:text-4xl">
            sdl.rentals — A Category-Defining Digital Asset
          </h2>
          <p class="max-w-xl leading-relaxed text-slate-400">
            Positioned at the intersection of Scottsdale rental branding, vacation and luxury home markets, and
            premium local SEO, this domain is a rare strategic asset. Serious buyers may inquire for pricing,
            transfer logistics, and escrow options.
          </p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-slate-950/90 p-6 backdrop-blur-xl sm:p-8">
          <p class="mb-2 text-xs font-semibold uppercase tracking-[2px] text-slate-500">Acquisition Contact</p>
          <a
            href={`mailto:${SITE.email}`}
            class="block break-all text-2xl font-semibold tracking-tight text-white transition hover:text-amber-400 sm:text-3xl"
          >
            {SITE.email}
          </a>
          <a
            href={ACQUISITION_MAILTO}
            class="mt-6 inline-flex w-full items-center justify-center gap-x-2 rounded-2xl bg-gradient-to-r from-amber-600 to-amber-700 px-6 py-4 font-extrabold text-white transition hover:brightness-110"
          >
            <span>Inquire About Acquisition</span>
            <span aria-hidden="true">→</span>
          </a>
          <p class="mt-4 text-center text-[11px] tracking-wide text-slate-500">
            Confidential inquiries &bull; Response within 24 hours
          </p>
        </div>
      </div>
    </div>

    <p class="mb-10 max-w-4xl text-xs leading-relaxed text-slate-500">
      This website is for demonstration and informational purposes only. It does not constitute an offer of services,
      a commitment to deploy, or a guarantee of outcomes. All statistics, projections, and references to specific
      technologies are based on publicly available information as of {DISCLAIMER_DATE} and are subject to change.
    </p>

    <div class="flex flex-col items-center justify-between gap-y-4 border-t border-slate-100 pt-8 text-xs text-slate-400 md:flex-row">
      <div>&copy; 2026 SDL Domains. All rights reserved. Scottsdale, Arizona.</div>
      <div>Premium vertical domains &bull; Serious buyers only</div>
    </div>
  </div>
</footer>
