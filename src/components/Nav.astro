---
import { ACQUISITION_MAILTO } from "../config/site";

interface Props {
  ctaEmail: string;
}

const { ctaEmail } = Astro.props;
---

<nav class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur-md">
  <div class="mx-auto max-w-6xl px-6">
    <div class="flex h-20 items-center justify-between">
      <div class="flex items-center gap-x-3">
        <div class="flex h-9 w-9 items-center justify-center rounded-2xl bg-slate-900">
          <span class="text-xl font-bold tracking-tighter text-white">SDL</span>
        </div>
        <div class="text-xl font-semibold tracking-tighter text-slate-900">
          sdl<span class="text-amber-700">.</span>rentals
        </div>
      </div>

      <div class="hidden items-center gap-x-8 text-sm font-medium md:flex">
        <a href="#why" class="nav-link text-slate-600 hover:text-slate-900">Why This Domain</a>
        <a href="#perfect-for" class="nav-link text-slate-600 hover:text-slate-900">Perfect For</a>
        <a href="#market" class="nav-link text-slate-600 hover:text-slate-900">Scottsdale Rentals Market</a>
        <a href="#inquire" class="nav-link text-slate-600 hover:text-slate-900">Inquire</a>
      </div>

      <div class="flex items-center gap-x-3">
        <a
          href="https://sdl.contact"
          target="_blank"
          rel="noreferrer"
          class="hidden rounded-3xl border border-slate-300 px-4 py-2 text-xs font-medium text-slate-600 transition hover:bg-slate-100 md:inline"
        >
          SDL Portfolio
        </a>
        <a
          href={ACQUISITION_MAILTO}
          class="rounded-3xl bg-slate-900 px-6 py-2.5 text-sm font-semibold text-white transition hover:bg-black active:scale-[0.985]"
        >
          Make an Offer
        </a>
      </div>
    </div>
  </div>
</nav>
