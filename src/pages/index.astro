        <button type="submit" data-track="cta-exit-capture" class="tap-target w-full rounded-2xl bg-slate-900 py-3.5 text-sm font-semibold text-white dark:bg-white dark:text-slate-900">Send me the brief</button>
      </form>
      <p id="exit-success" class="mt-3 hidden text-sm font-medium text-emerald-600">You’re on the list — check your inbox.</p>
      <button id="exit-close" type="button" class="tap-target mt-3 w-full rounded-2xl border border-slate-200 py-3 text-sm font-semibold dark:border-white/10">No thanks, I’ll risk missing it</button>
    </div>
  </div>

  <script is:inline>
    // Theme: persist + respect OS, default dark (brand hero is dark)
    (function () {
      try {
        var stored = localStorage.getItem("sdl-theme");
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        var dark = stored ? stored === "dark" : true;
        document.documentElement.classList.toggle("dark", dark);
        if (!stored && !prefersDark) document.documentElement.classList.remove("dark");
      } catch (e) {}
    })();

    document.addEventListener("DOMContentLoaded", function () {
      var root = document.documentElement;

      // Theme toggle
      var toggle = document.getElementById("theme-toggle");
      if (toggle) {
        toggle.addEventListener("click", function () {
          var dark = !root.classList.contains("dark");
          root.classList.toggle("dark", dark);
          try { localStorage.setItem("sdl-theme", dark ? "dark" : "light"); } catch (e) {}
        });
      }

      // Mobile menu
      var btn = document.getElementById("menu-button");
      var menu = document.getElementById("mobile-menu");
      if (btn && menu) {
        btn.addEventListener("click", function () {
          var open = menu.classList.toggle("hidden");
          btn.setAttribute("aria-expanded", String(!open));
          btn.setAttribute("aria-label", open ? "Open menu" : "Close menu");
        });
        menu.querySelectorAll("a").forEach(function (a) {
          a.addEventListener("click", function () {
            menu.classList.add("hidden");
            btn.setAttribute("aria-expanded", "false");
          });
        });
      }

      // Scroll reveal
      try {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) { en.target.classList.add("is-visible"); io.unobserve(en.target); }
          });
        }, { threshold: 0.12 });
        document.querySelectorAll(".reveal").forEach(function (el) { io.observe(el); });
      } catch (e) {
        document.querySelectorAll(".reveal").forEach(function (el) { el.classList.add("is-visible"); });
      }

      // Urgency: pseudo-live viewer count (stable per day + jitter, capped)
      try {
        var key = "sdl-rentals-viewers";
        var today = new Date().toISOString().slice(0, 10);
        var raw = JSON.parse(localStorage.getItem(key) || "{}");
        if (raw.day !== today) {
          raw = { day: today, base: 21 + Math.floor(Math.random() * 14) };
          localStorage.setItem(key, JSON.stringify(raw));
        }
        var el = document.getElementById("viewer-count");
        if (el) el.textContent = String(raw.base);
      } catch (e) {}

      // Portfolio filter + search
      var filterBtns = Array.prototype.slice.call(document.querySelectorAll(".portfolio-filter"));
      var search = document.getElementById("portfolio-search");
      var cards = Array.prototype.slice.call(document.querySelectorAll(".portfolio-card"));
      var empty = document.getElementById("portfolio-empty");
      var active = "all";
      function applyFilter() {
        var q = (search && search.value || "").toLowerCase().trim();
        var shown = 0;
        cards.forEach(function (card) {
          var cat = (card.getAttribute("data-category") || "");
          var name = (card.getAttribute("data-name") || "").toLowerCase();
          var tags = (card.getAttribute("data-tags") || "").toLowerCase();
          var okCat = active === "all" || cat.indexOf(active) !== -1;
          var okQ = !q || name.indexOf(q) !== -1 || tags.indexOf(q) !== -1;
          var show = okCat && okQ;
          card.style.display = show ? "" : "none";
          if (show) shown++;
        });
        if (empty) empty.classList.toggle("hidden", shown !== 0);
      }
      filterBtns.forEach(function (b) {
        b.addEventListener("click", function () {
          active = b.getAttribute("data-filter") || "all";
          filterBtns.forEach(function (x) {
            var on = x === b;
            x.setAttribute("aria-pressed", String(on));
            x.className = "portfolio-filter tap-target rounded-full px-4 text-sm font-medium " + (on
              ? "bg-slate-900 text-white dark:bg-white dark:text-slate-900"
              : "border border-slate-200 dark:border-white/15");
          });
          applyFilter();
        });
      });
      if (search) search.addEventListener("input", applyFilter);

      // Inquiry form: validate -> POST /api/inquire -> mailto fallback -> success
      var form = document.getElementById("inquire-offer");
      if (form) {
        form.addEventListener("submit", function (e) {
          e.preventDefault();
          var err = document.getElementById("form-error");
          var ok = document.getElementById("form-success");
          var submit = document.getElementById("inquiry-submit");
          if (err) { err.classList.add("hidden"); err.textContent = ""; }
          if (ok) ok.classList.add("hidden");

          var name = document.getElementById("inquiry-name").value.trim();
          var email = document.getElementById("inquiry-email").value.trim();
          var useCase = document.getElementById("inquiry-use").value;
          var offer = document.getElementById("inquiry-offer").value;
          var message = document.getElementById("inquiry-message").value.trim();

          function fail(msg) {
            if (err) { err.textContent = msg; err.classList.remove("hidden"); }
            return false;
          }
          if (name.length < 2) return fail("Please enter your name.");
          if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) return fail("Please enter a valid email address.");
          if (!useCase) return fail("Please select the intended use.");
          if (!offer || Number(offer) < 10000) return fail("Minimum serious offer is $10,000.");

          var original = submit.textContent;
          submit.textContent = "SENDING…";
          submit.disabled = true;

          var payload = { name: name, email: email, useCase: useCase, offer: Number(offer), message: message, domain: "sdl.rentals" };
          fetch("/api/inquire", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          }).then(function (r) {
            return r.ok ? r.json().catch(function(){ return {}; }) : Promise.reject(new Error("api"));
          }).then(function () {
            if (ok) ok.classList.remove("hidden");
            form.reset();
            track("inquiry_submitted", { offer: payload.offer });
          }).catch(function () {
            // Graceful fallback: open mail client with prefilled body
            var body = encodeURIComponent("Name: " + name + "\nEmail: " + email + "\nIntended use: " + useCase + "\nOffer: $" + offer + "\nDetails: " + message);
            window.location.href = "mailto:sales@desertrich.com?subject=" + encodeURIComponent("SDL.Rentals Acquisition Inquiry — $" + offer) + "&body=" + body;
            if (ok) ok.classList.remove("hidden");
          }).finally(function () {
            submit.textContent = original;
            submit.disabled = false;
          });
        });
      }

      // Exit-intent (desktop) + timed fallback (mobile, once per 7 days)
      var popup = document.getElementById("exit-popup");
      var closed = false;
      function seenRecently() {
        try {
          var t = Number(localStorage.getItem("sdl-rentals-exit-seen") || "0");
          return Date.now() - t < 7 * 864e5;
        } catch (e) { return true; }
      }
      function markSeen() {
        try { localStorage.setItem("sdl-rentals-exit-seen", String(Date.now())); } catch (e) {}
      }
      function openPopup() {
        if (closed || !popup || seenRecently()) return;
        popup.classList.remove("hidden");
        popup.classList.add("flex");
        markSeen();
        track("exit_popup_shown", {});
      }
      function closePopup() {
        if (!popup) return;
        closed = true;
        popup.classList.add("hidden");
        popup.classList.remove("flex");
      }
      document.addEventListener("mouseout", function (e) {
        if (!e.relatedTarget && e.clientY <= 0) openPopup();
      });
      setTimeout(function () {
        if (!closed && "ontouchstart" in window) openPopup();
      }, 45000);
      var closeBtn = document.getElementById("exit-close");
      if (closeBtn) closeBtn.addEventListener("click", closePopup);
      if (popup) popup.addEventListener("click", function (e) { if (e.target === popup) closePopup(); });
      document.addEventListener("keydown", function (e) { if (e.key === "Escape") closePopup(); });

      var exitForm = document.getElementById("exit-form");
      if (exitForm) {
        exitForm.addEventListener("submit", function (e) {
          e.preventDefault();
          var email = document.getElementById("exit-email").value.trim();
          if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) return;
          fetch("/api/subscribe", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email: email, interest: "sdl.rentals brief" }),
          }).catch(function () {}).finally(function () {
            var s = document.getElementById("exit-success");
            if (s) s.classList.remove("hidden");
            track("email_captured", {});
            setTimeout(closePopup, 1600);
          });
        });
      }

      // Lightweight analytics hook (data-track attrs; swap for real pixels)
      function track(name, data) {
        try {
          if (window.plausible) window.plausible(name, { props: data });
          document.dispatchEvent(new CustomEvent("sdl:track", { detail: { name: name, data: data } }));
        } catch (e) {}
      }
      document.querySelectorAll("[data-track]").forEach(function (el) {
        el.addEventListener("click", function () {
          track(el.getAttribute("data-track") || "cta_click", { href: el.getAttribute("href") || "" });
        });
      });
    });
  </script>
</BaseLayout>
