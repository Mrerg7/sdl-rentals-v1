---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const entry = await getEntry("site", "home");
if (!entry) throw new Error("Missing content entry: site/home");

const { ctaEmail, image, favicon } = entry.data;

const title = "sdl.rentals | Premium Domain for Sale | SDL Rentals Scottsdale";
const metaDescription =
  "sdl.rentals for sale — premium .rentals domain for Scottsdale vacation, luxury & long-term rentals. Asking $55k (serious offers from $28k). Secure escrow transfer. Inquire now — 1 of 1 asset.";
const keywords =
  "buy .rentals domains, sdl.rentals for sale, premium domain names, Scottsdale rentals domain, vacation rental domain for sale, luxury rentals domain, investment domains, brandable domains, expired domains, domain marketplace";

const escrowMailto = `mailto:${ctaEmail}?subject=${encodeURIComponent("SDL.Rentals Acquisition Inquiry — $55k Asking")}`;
---

<BaseLayout
  title={title}
  description={metaDescription}
  image={image}
  favicon={favicon}
  keywords={keywords}
  canonicalPath="/"
>
  <!-- ============ NAV (mobile hamburger + 48px targets + theme toggle) ============ -->
  <nav class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur-md dark:border-white/10 dark:bg-slate-950/90" aria-label="Primary">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="flex h-20 items-center justify-between gap-2">
        <a href="/" class="tap-target flex items-center gap-x-3 rounded-xl" aria-label="sdl.rentals home">
          <div class="flex h-9 w-9 items-center justify-center rounded-2xl bg-slate-900 dark:bg-white">
            <span class="text-2xl font-bold tracking-tighter text-white dark:text-slate-900">SDL</span>
          </div>
          <div class="text-xl font-semibold tracking-tighter text-slate-900 dark:text-white">
            sdl<span class="text-amber-700">.</span>rentals
          </div>
        </a>

        <div class="hidden items-center gap-x-8 text-sm font-medium md:flex">
          <a href="#why" class="tap-target inline-flex items-center text-slate-600 transition hover:text-amber-700 dark:text-slate-300">Why This Domain</a>
          <a href="#perfect-for" class="tap-target inline-flex items-center text-slate-600 transition hover:text-amber-700 dark:text-slate-300">Perfect For</a>
          <a href="#market" class="tap-target inline-flex items-center text-slate-600 transition hover:text-amber-700 dark:text-slate-300">Market</a>
          <a href="#faq" class="tap-target inline-flex items-center text-slate-600 transition hover:text-amber-700 dark:text-slate-300">FAQ</a>
          <a href="#inquire" class="tap-target inline-flex items-center text-slate-600 transition hover:text-amber-700 dark:text-slate-300">Inquire</a>
        </div>

        <div class="flex items-center gap-x-2">
          <button
            id="theme-toggle"
            type="button"
            class="tap-target inline-flex items-center justify-center rounded-2xl border border-slate-300 px-3 text-sm dark:border-white/15"
            aria-label="Toggle dark mode"
            title="Toggle dark / light mode"
          >
            <span id="theme-icon" aria-hidden="true">◐</span>
          </button>
          <a
            href="https://sdl.contact"
            target="_blank"
            rel="noreferrer"
            class="tap-target hidden items-center rounded-3xl border border-slate-300 px-4 text-xs font-medium text-slate-600 transition hover:bg-slate-100 md:inline-flex dark:border-white/15 dark:text-slate-300"
          >
            SDL Portfolio
          </a>
          <a
            href="#inquire"
            data-track="cta-nav-make-offer"
            class="tap-target inline-flex items-center rounded-3xl bg-slate-900 px-5 text-sm font-semibold text-white transition hover:bg-black dark:bg-white dark:text-slate-900"
          >
            Make an Offer
          </a>
          <button
            id="menu-button"
            type="button"
            class="tap-target inline-flex items-center justify-center rounded-2xl border border-slate-300 px-3 text-xl md:hidden dark:border-white/15"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Open menu"
          >
            ☰
          </button>
        </div>
      </div>
    </div>
    <div id="mobile-menu" class="hidden border-t border-slate-200 bg-white px-6 py-4 md:hidden dark:border-white/10 dark:bg-slate-950">
      <div class="grid gap-1 text-base font-medium">
        <a href="#why" class="tap-target flex items-center rounded-xl px-2 text-slate-700 dark:text-slate-200">Why This Domain</a>
        <a href="#perfect-for" class="tap-target flex items-center rounded-xl px-2 text-slate-700 dark:text-slate-200">Perfect For</a>
        <a href="#market" class="tap-target flex items-center rounded-xl px-2 text-slate-700 dark:text-slate-200">Market</a>
        <a href="#portfolio" class="tap-target flex items-center rounded-xl px-2 text-slate-700 dark:text-slate-200">Portfolio</a>
        <a href="#faq" class="tap-target flex items-center rounded-xl px-2 text-slate-700 dark:text-slate-200">FAQ</a>
        <a href="#inquire" data-track="cta-mobile-inquire" class="tap-target flex items-center rounded-xl px-2 font-semibold text-amber-700">Inquire to Purchase →</a>
      </div>
    </div>
  </nav>

  <!-- ============ HERO / ABOVE THE FOLD ============ -->
  <header class="relative flex min-h-[640px] items-center overflow-hidden bg-slate-950 md:min-h-[700px]">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style={`background-image: linear-gradient(to right, rgb(2 6 23 / 0.96), rgb(2 6 23 / 0.86), rgb(2 6 23 / 0.72)), url('${image}')`}
      aria-hidden="true"
    ></div>

    <div id="main" class="relative mx-auto w-full max-w-5xl px-6 pt-10 md:pt-0">
      <div class="max-w-3xl">
        <div class="mb-6 inline-flex flex-wrap items-center gap-x-2 gap-y-1 rounded-3xl border border-white/20 bg-white/10 px-4 py-1.5 backdrop-blur-md">
          <div class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-400" aria-hidden="true"></div>
          <span class="text-xs font-semibold tracking-[1.5px] text-white/90">
            PREMIUM .RENTALS DOMAIN • SCOTTSDALE, AZ • 1 OF 1 ASSET
          </span>
        </div>

        <h1 class="text-white">
          <span class="domain-name block font-bold tracking-tighter">sdl.rentals</span>
          <span class="mt-3 block max-w-xl text-xl font-normal tracking-tight text-white/85 md:text-2xl">
            The rare, premium domain that captures all rental properties in Scottsdale, Arizona.
          </span>
        </h1>

        <!-- Price + urgency panel -->
        <div class="mt-7 flex flex-wrap items-center gap-3" role="status" aria-live="polite">
          <div class="rounded-2xl border border-amber-300/40 bg-amber-300/10 px-5 py-3 backdrop-blur-md">
            <div class="text-[11px] font-semibold tracking-[1.5px] text-amber-200">ASKING $55,000</div>
            <div class="text-lg font-semibold text-white">Serious offers from $28,000</div>
          </div>
          <div class="rounded-2xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
            <div class="text-sm font-semibold text-white"><span id="viewer-count">27</span> buyers viewed this week</div>
            <div class="text-xs text-white/70">Exclusive • First-come, confidential escrow transfer</div>
          </div>
        </div>

        <!-- Triple CTA by price tier -->
        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href="#inquire"
            data-track="cta-hero-buy-now"
            class="tap-target inline-flex items-center justify-center rounded-3xl bg-white px-8 text-base font-semibold text-slate-900 shadow-xl transition hover:bg-amber-50"
          >
            Buy Now — Inquire
          </a>
          <a
            href="#inquire-offer"
            data-track="cta-hero-make-offer"
            class="tap-target inline-flex items-center justify-center rounded-3xl bg-amber-500 px-8 text-base font-semibold text-slate-950 shadow-xl transition hover:bg-amber-400"
          >
            Make an Offer
          </a>
          <a
            href={escrowMailto}
            data-track="cta-hero-contact-agent"
            class="tap-target inline-flex items-center justify-center rounded-3xl border border-white/30 px-8 text-base font-semibold text-white transition hover:bg-white/10"
          >
            Contact Agent
          </a>
        </div>

        <!-- Trust signals -->
        <ul class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-white/75" aria-label="Buyer protections">
          <li class="inline-flex items-center gap-1.5"><span aria-hidden="true">🔒</span> Secure Escrow.com transfer</li>
          <li class="inline-flex items-center gap-1.5"><span aria-hidden="true">✓</span> SSL &amp; verified ownership</li>
          <li class="inline-flex items-center gap-1.5"><span aria-hidden="true">🤝</span> Transaction guarantee</li>
          <li class="inline-flex items-center gap-1.5"><span aria-hidden="true">⚡</span> Response in 24–48h</li>
        </ul>

        <div class="mt-6 flex items-center gap-x-6 text-xs text-white/60">
          <div>Short • Memorable • Market-Owning</div>
          <div class="h-3 w-px bg-white/30" aria-hidden="true"></div>
          <div>Vacation • Luxury • Long-Term Rentals</div>
        </div>
      </div>
    </div>
  </header>

  <!-- Trust bar -->
  <div class="border-b border-slate-200 bg-white dark:border-white/10 dark:bg-slate-900">
    <div class="mx-auto max-w-5xl px-6 py-5">
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-center text-sm md:justify-between md:text-left">
        <div class="flex items-center gap-x-2">
          <span class="font-medium text-emerald-600">11M+ visitors • $3.7B economic impact (2024)</span>
          <span class="text-slate-400">Scottsdale tourism</span>
        </div>
        <div class="hidden text-slate-300 md:block" aria-hidden="true">•</div>
        <div class="text-slate-600 dark:text-slate-300">Arizona's premier destination for luxury vacation &amp; rental properties</div>
      </div>
      <div class="mt-3 flex flex-wrap items-center justify-center gap-2 text-[11px] font-medium text-slate-500 dark:text-slate-400">
        <span class="rounded-full border border-slate-200 px-3 py-1.5 dark:border-white/10">Escrow.com protected</span>
        <span class="rounded-full border border-slate-200 px-3 py-1.5 dark:border-white/10">Registrar-lock verified</span>
        <span class="rounded-full border border-slate-200 px-3 py-1.5 dark:border-white/10">Confidential transfer</span>
        <a href="#faq" class="rounded-full border border-amber-200 bg-amber-50 px-3 py-1.5 text-amber-800 dark:bg-amber-950 dark:text-amber-200">How buying works →</a>
      </div>
    </div>
  </div>

  <main class="bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-200">
    <!-- WHY -->
    <section class="reveal mx-auto max-w-5xl px-6 pb-12 pt-16" id="why" aria-labelledby="why-heading">
      <div class="max-w-2xl">
        <div class="mb-3 text-xs font-semibold uppercase tracking-[2px] text-amber-700">The Opportunity</div>
        <h2 id="why-heading" class="heading-serif text-4xl font-semibold tracking-tighter text-slate-900 md:text-5xl dark:text-white">
          Own the definitive domain<br />for Scottsdale rentals.
        </h2>
        <p class="mt-5 text-lg text-slate-600 dark:text-slate-300">
          SDL.Rentals is short, powerful, and perfectly descriptive. It instantly communicates
          "Scottsdale Rentals" and positions the owner as the central player in one of Arizona's
          strongest short-term and luxury rental markets. A rare opportunity to own the exact-match
          premium branding for rentals in Scottsdale.
        </p>
        <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">
          New to premium domains? Read our
          <a href="/valuation-guide/" class="font-medium text-amber-700 underline-offset-2 hover:underline">domain valuation guide</a>
          and <a href="#faq" class="font-medium text-amber-700 underline-offset-2 hover:underline">buying FAQ</a>.
        </p>
      </div>

      <div class="mt-12 grid gap-5 md:grid-cols-3">
        <div class="value-card rounded-3xl border border-slate-200 bg-white p-7 dark:border-white/10 dark:bg-slate-900">
          <div class="mb-3 text-xs font-semibold tracking-widest text-amber-700">BRAND POWER</div>
          <div class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">Instant market ownership</div>
          <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
            "SDL.Rentals" clearly owns the Scottsdale rental narrative. Short, memorable, and highly
            brandable. Perfect for building instant recognition with property owners and renters.
          </p>
        </div>
        <div class="value-card rounded-3xl border border-slate-200 bg-white p-7 dark:border-white/10 dark:bg-slate-900">
          <div class="mb-3 text-xs font-semibold tracking-widest text-amber-700">MARKET FIT</div>
          <div class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">Explosive rental demand</div>
          <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
            Scottsdale's massive tourism (11M+ visitors), luxury resorts, golf communities, and affluent
            second-home owners create one of Arizona's hottest short-term and premium long-term markets.
          </p>
        </div>
        <div class="value-card rounded-3xl border border-slate-200 bg-white p-7 dark:border-white/10 dark:bg-slate-900">
          <div class="mb-3 text-xs font-semibold tracking-widest text-amber-700">COMPETITIVE EDGE</div>
          <div class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">Rare &amp; defensible</div>
          <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
            Premium exact-match domains in high-demand verticals like rentals are extremely rare. Owning
            SDL.Rentals gives you an unmatched branding and SEO advantage in the Scottsdale rental space.
          </p>
        </div>
      </div>

      <!-- Social proof -->
      <div class="mt-10 rounded-3xl border border-slate-200 bg-white p-7 dark:border-white/10 dark:bg-slate-900">
        <div class="text-xs font-semibold tracking-widest text-amber-700">TRUSTED BY OPERATORS &amp; INVESTORS</div>
        <div class="mt-4 grid gap-5 md:grid-cols-3">
          <figure>
            <blockquote class="text-sm text-slate-600 dark:text-slate-300">"Exact-match geo + vertical domains like this print trust. Guests click, owners list — the brand does the selling."</blockquote>
            <figcaption class="mt-2 text-xs font-medium text-slate-500">— Operator, vacation-rental marketplace</figcaption>
          </figure>
          <figure>
            <blockquote class="text-sm text-slate-600 dark:text-slate-300">"We moved our management firm to a category domain. Owner acquisition cost dropped in the first season."</blockquote>
            <figcaption class="mt-2 text-xs font-medium text-slate-500">— Founder, luxury property-management brand</figcaption>
          </figure>
          <figure>
            <blockquote class="text-sm text-slate-600 dark:text-slate-300">"Escrow transfer was seamless — funds released only after we confirmed control. Zero risk."</blockquote>
            <figcaption class="mt-2 text-xs font-medium text-slate-500">— Buyer, premium rentals domain</figcaption>
          </figure>
        </div>
        <div class="mt-4 border-t border-slate-100 pt-4 text-xs text-slate-500 dark:border-white/10 dark:text-slate-400">
          Recent comparable premium geo + rental/travel sales: short exact-match names $25k–$120k (2023–2026, public reports). SDL.Rentals offered at market — asking $55k.
        </div>
      </div>
    </section>

    <!-- PERFECT FOR -->
    <section class="reveal border-y border-slate-100 bg-white py-16 dark:border-white/10 dark:bg-slate-900" id="perfect-for" aria-labelledby="perfect-heading">
      <div class="mx-auto max-w-5xl px-6">
        <div class="mb-10 max-w-xl">
          <div class="mb-3 text-xs font-semibold uppercase tracking-[2px] text-amber-700">Ideal Use Cases</div>
          <h2 id="perfect-heading" class="text-3xl font-semibold tracking-tighter text-slate-900 md:text-4xl dark:text-white">Built for leaders in the Scottsdale rental market.</h2>
        </div>

        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          <div class="rounded-3xl border border-slate-200 bg-white p-7 dark:border-white/10 dark:bg-slate-950">
            <div class="mb-4 text-3xl" aria-hidden="true">🏠</div>
            <h3 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">Vacation Rental Platform</h3>
            <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">Flagship domain for a curated marketplace or booking platform specializing in luxury vacation homes, villas, and resort-style rentals across Scottsdale.</p>
          </div>
          <div class="rounded-3xl border border-slate-200 bg-white p-7 dark:border-white/10 dark:bg-slate-950">
            <div class="mb-4 text-3xl" aria-hidden="true">📋</div>
            <h3 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">Property Management Company</h3>
            <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">Ideal for a premium property management firm handling short-term vacation rentals and luxury long-term leases in Scottsdale's most desirable neighborhoods.</p>
          </div>
          <div class="rounded-3xl border border-slate-200 bg-white p-7 dark:border-white/10 dark:bg-slate-950">
            <div class="mb-4 text-3xl" aria-hidden="true">✨</div>
            <h3 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">Luxury Home Rentals Brand</h3>
            <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">Perfect for a high-end rental company offering exclusive, fully-managed luxury homes and estates for discerning travelers and seasonal residents.</p>
          </div>
          <div class="rounded-3xl border border-slate-200 bg-white p-7 dark:border-white/10 dark:bg-slate-950">
            <div class="mb-4 text-3xl" aria-hidden="true">🌐</div>
            <h3 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">Rental Marketplace or Directory</h3>
            <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">Strong foundation for a comprehensive Scottsdale rental listings site, connecting owners with renters for short-term stays and longer-term leases.</p>
          </div>
          <div class="rounded-3xl border border-slate-200 bg-white p-7 dark:border-white/10 dark:bg-slate-950">
            <div class="mb-4 text-3xl" aria-hidden="true">🏌️</div>
            <h3 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">Golf &amp; Resort Rental Specialist</h3>
            <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">Excellent for a specialized rental brand focused on luxury properties near Scottsdale's world-class golf courses, resorts, and country clubs.</p>
          </div>
          <div class="rounded-3xl border border-slate-200 bg-white p-7 dark:border-white/10 dark:bg-slate-950">
            <div class="mb-4 text-3xl" aria-hidden="true">📈</div>
            <h3 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">Real Estate Investment Rentals</h3>
            <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">Ideal for an investment firm or platform focused on acquiring, managing, and renting high-performing properties in Scottsdale's strong rental markets.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- MARKET -->
    <section class="reveal mx-auto max-w-5xl px-6 py-16" id="market" aria-labelledby="market-heading">
      <div class="mb-10 max-w-2xl">
        <div class="mb-3 text-xs font-semibold uppercase tracking-[2px] text-amber-700">The Market</div>
        <h2 id="market-heading" class="text-3xl font-semibold tracking-tighter text-slate-900 md:text-4xl dark:text-white">
          Scottsdale has one of Arizona's strongest and most dynamic rental markets.
        </h2>
        <p class="mt-4 text-slate-600 dark:text-slate-300">
          Driven by world-class tourism, luxury resorts, golf communities, and a large affluent/second-home
          owner base, Scottsdale offers exceptional opportunities in both short-term vacation rentals and
          premium long-term rentals.
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        <div class="market-stat rounded-3xl border border-slate-200 bg-white p-7 dark:border-white/10 dark:bg-slate-900">
          <div class="mb-2 text-xs font-semibold tracking-widest text-amber-700">TOURISM DRIVEN DEMAND</div>
          <div class="text-lg font-semibold text-slate-900 dark:text-white">Massive Visitor Volume</div>
          <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">Scottsdale welcomed over 11 million visitors in 2024, generating $3.7 billion in economic impact — consistent, high demand for quality short-term vacation rentals year-round.</p>
        </div>
        <div class="market-stat rounded-3xl border border-slate-200 bg-white p-7 dark:border-white/10 dark:bg-slate-900">
          <div class="mb-2 text-xs font-semibold tracking-widest text-amber-700">LUXURY RENTAL APPEAL</div>
          <div class="text-lg font-semibold text-slate-900 dark:text-white">Premium Properties in Demand</div>
          <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">High-net-worth travelers and seasonal residents actively seek luxury vacation homes, villas, and resort-style properties near golf courses, spas, and upscale amenities.</p>
        </div>
        <div class="market-stat rounded-3xl border border-slate-200 bg-white p-7 dark:border-white/10 dark:bg-slate-900">
          <div class="mb-2 text-xs font-semibold tracking-widest text-amber-700">DIVERSE RENTAL TYPES</div>
          <div class="text-lg font-semibold text-slate-900 dark:text-white">Short-Term + Long-Term Strength</div>
          <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">Strong market for both short-term vacation rentals (Airbnb/VRBO style) and premium long-term rentals, supported by growth and snowbird/second-home owners.</p>
        </div>
        <div class="market-stat rounded-3xl border border-slate-200 bg-white p-7 dark:border-white/10 dark:bg-slate-900">
          <div class="mb-2 text-xs font-semibold tracking-widest text-amber-700">PROPERTY OWNER OPPORTUNITY</div>
          <div class="text-lg font-semibold text-slate-900 dark:text-white">High-Yield Investment Potential</div>
          <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">Many Scottsdale homeowners and investors seek professional management and marketing for their properties — strong demand for premium rental services and platforms.</p>
        </div>
        <div class="market-stat rounded-3xl border border-slate-200 bg-white p-7 dark:border-white/10 dark:bg-slate-900">
          <div class="mb-2 text-xs font-semibold tracking-widest text-amber-700">LOCATION ADVANTAGE</div>
          <div class="text-lg font-semibold text-slate-900 dark:text-white">Desert Luxury + Accessibility</div>
          <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">Stunning desert setting, proximity to Phoenix, world-class golf/resorts, and vibrant Old Town/North Scottsdale areas attract guests and long-term tenants alike.</p>
        </div>
        <div class="market-stat rounded-3xl border border-slate-200 bg-white p-7 dark:border-white/10 dark:bg-slate-900">
          <div class="mb-2 text-xs font-semibold tracking-widest text-amber-700">BRANDING ADVANTAGE</div>
          <div class="text-lg font-semibold text-slate-900 dark:text-white">Own the Category</div>
          <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">SDL.Rentals gives you instant category ownership in one of Arizona's most active and lucrative rental markets — a rare and defensible branding asset.</p>
        </div>
      </div>

      <p class="mt-8 max-w-3xl text-xs text-slate-500 dark:text-slate-400">
        Market insights based on Scottsdale tourism data (11M+ visitors in 2024, $3.7B impact) and local
        real estate/rental market trends. Figures are approximate and subject to change.
      </p>
    </section>

    <!-- PORTFOLIO with search + filters -->
