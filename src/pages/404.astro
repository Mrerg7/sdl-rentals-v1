---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found | sdl.rentals"
  description="The page you requested could not be found. Return to sdl.rentals — premium domain for sale (asking $55k)."
  image="https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/3e5fb84a-7803-415b-daf5-4d21bdcca700/public"
  favicon="https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/3e5fb84a-7803-415b-daf5-4d21bdcca700/public"
  canonicalPath="/404/"
  noindex={true}
>
  <main id="main" class="flex min-h-screen items-center justify-center bg-slate-950 px-6 text-center">
    <div>
      <div class="text-sm tracking-[2px] text-amber-400">404 — NOT FOUND</div>
      <h1 class="domain-name mt-2 font-bold text-white">sdl.rentals</h1>
      <p class="mx-auto mt-4 max-w-md text-white/70">That page doesn’t exist — but this domain does. And it’s for sale.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="tap-target inline-flex items-center justify-center rounded-3xl bg-white px-8 font-semibold text-slate-900">Back to sdl.rentals →</a>
        <a href="/faq/" class="tap-target inline-flex items-center justify-center rounded-3xl border border-white/25 px-8 font-semibold text-white">Buying FAQ</a>
