---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "sdl.rentals FAQ | Buying a Premium Domain, Escrow & Transfer | SDL";
const description =
  "How to buy sdl.rentals: pricing (asking $55k, offers from $28k), secure Escrow.com transfer, timelines, installments, and bundle options. Confidential replies in 24–48h.";
const image =
  "https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/3e5fb84a-7803-415b-daf5-4d21bdcca700/public";
const favicon =
  "https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/3e5fb84a-7803-415b-daf5-4d21bdcca700/public";
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  favicon={favicon}
  canonicalPath="/faq/"
  keywords="sdl.rentals FAQ, how to buy a domain, escrow domain transfer, premium domain price, buy .rentals domains, domain marketplace"
>
  <main id="main" class="min-h-screen bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-200">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <a href="/" class="text-sm font-medium text-amber-700 hover:underline">← Back to sdl.rentals</a>
      <p class="mt-6 text-xs font-semibold uppercase tracking-[2px] text-amber-700">Buying FAQ</p>
      <h1 class="heading-serif mt-2 text-4xl font-semibold tracking-tighter text-slate-900 md:text-5xl dark:text-white">
        sdl.rentals | Premium Domain for Sale — FAQ
      </h1>
      <p class="mt-4 text-slate-600 dark:text-slate-300">
        Everything serious buyers ask before acquiring sdl.rentals. Ready?{" "}
        <a href="/#inquire-offer" class="font-semibold text-amber-700 hover:underline">Make an offer</a> or email{" "}
        <a href="mailto:sales@desertrich.com" class="font-semibold text-amber-700 hover:underline">sales@desertrich.com</a>.
      </p>

      <div class="mt-10 space-y-3">
        <details class="faq rounded-2xl border border-slate-200 bg-white p-5 dark:border-white/10 dark:bg-slate-900" open>
          <summary class="tap-target flex cursor-pointer items-center justify-between gap-4 font-semibold">Is sdl.rentals for sale? <span class="faq-chevron">▾</span></summary>
          <p class="mt-3 text-sm">Yes. Confidential acquisition for serious buyers. Asking $55,000; offers from $28,000. Transfer via licensed escrow (Escrow.com or equivalent).</p>
        </details>
        <details class="faq rounded-2xl border border-slate-200 bg-white p-5 dark:border-white/10 dark:bg-slate-900">
          <summary class="tap-target flex cursor-pointer items-center justify-between gap-4 font-semibold">What is the price? <span class="faq-chevron">▾</span></summary>
          <p class="mt-3 text-sm">Asking $55,000; serious offers from $28,000. Comparable premium geo + rental/travel exact-match names trade $25k–$120k. Include your intended use and offer for a 24–48h response.</p>
        </details>
        <details class="faq rounded-2xl border border-slate-200 bg-white p-5 dark:border-white/10 dark:bg-slate-900">
          <summary class="tap-target flex cursor-pointer items-center justify-between gap-4 font-semibold">How does escrow work? <span class="faq-chevron">▾</span></summary>
          <ol class="mt-3 list-decimal pl-5 text-sm space-y-1">
            <li>Agree price + sign escrow instructions.</li>
            <li>Buyer funds escrow.</li>
            <li>We push / Auth-code the domain to your registrar account.</li>
            <li>You confirm control → escrow releases funds.</li>
          </ol>
        </details>
        <details class="faq rounded-2xl border border-slate-200 bg-white p-5 dark:border-white/10 dark:bg-slate-900">
          <summary class="tap-target flex cursor-pointer items-center justify-between gap-4 font-semibold">How long does transfer take? <span class="faq-chevron">▾</span></summary>
          <p class="mt-3 text-sm">Same-registrar push: hours. Inter-registrar with Auth code: typically 1–5 days. Escrow adds 1–2 days for verification.</p>
        </details>
        <details class="faq rounded-2xl border border-slate-200 bg-white p-5 dark:border-white/10 dark:bg-slate-900">
          <summary class="tap-target flex cursor-pointer items-center justify-between gap-4 font-semibold">Installments or bundles? <span class="faq-chevron">▾</span></summary>
          <p class="mt-3 text-sm">Qualified buyers can request escrow-held installments. Portfolio bundles (sdl.rentals + sdlrealtor.com / sdl.contact / sdl.life) available — ask in your inquiry.</p>
        </details>
        <details class="faq rounded-2xl border border-slate-200 bg-white p-5 dark:border-white/10 dark:bg-slate-900">
          <summary class="tap-target flex cursor-pointer items-center justify-between gap-4 font-semibold">Why .rentals for Scottsdale? <span class="faq-chevron">▾</span></summary>
          <p class="mt-3 text-sm">SDL = Scottsdale shorthand; .rentals = exact vertical match. Short, descriptive, and category-owning — ideal for vacation platforms, luxury brands, management firms, and marketplaces in an 11M-visitor market.</p>
        </details>
      </div>

      <div class="mt-10 rounded-3xl bg-slate-900 p-8 text-center dark:bg-black dark:border dark:border-white/10">
        <h2 class="text-2xl font-semibold text-white">Ready to own sdl.rentals?</h2>
        <p class="mt-2 text-sm text-white/70">Asking $55k • Offers from $28k • Escrow-protected</p>
        <a href="/#inquire-offer" class="tap-target mt-5 inline-flex items-center justify-center rounded-3xl bg-white px-8 font-semibold text-slate-900">Make an Offer →</a>
      </div>
    </div>
  </main>
</BaseLayout>
